{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detecthiddenfees.com/schemas/search-console-opportunities.json",
  "title": "Private Search Console Opportunity Scores",
  "type": "object",
  "required": ["source_status", "generated_at", "records", "opportunities"],
  "properties": {
    "source_status": { "const": "connected" },
    "generated_at": { "type": "string", "format": "date-time" },
    "input_file": { "type": "string", "minLength": 1 },
    "records": { "type": "integer", "minimum": 1 },
    "privacy_note": { "type": "string", "minLength": 1 },
    "scoring_note": { "type": "string", "minLength": 1 },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["query", "page", "score", "reason_codes", "evidence"],
        "properties": {
          "query": { "type": "string", "minLength": 1 },
          "page": { "type": "string", "pattern": "^https://detecthiddenfees\\.com/" },
          "score": { "type": "number", "minimum": 0 },
          "reason_codes": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "object" },
          "trend": { "type": ["string", "null"] },
          "intent_source": { "type": ["string", "null"] },
          "hiddenfeeai_relevance": { "type": ["boolean", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
