{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detecthiddenfees.com/schemas/evidence-register.json",
  "title": "DetectHiddenFees Evidence Register",
  "type": "object",
  "required": ["version", "status", "description", "source_priority", "records"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["collecting", "review", "published"] },
    "description": { "type": "string", "minLength": 20 },
    "source_priority": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_id", "page_url", "claim_type", "risk_level", "claim_text", "status", "source_url", "source_type", "evidence_reference", "reviewed_at", "reviewer", "notes"],
        "properties": {
          "record_id": { "type": "string", "pattern": "^EV-[0-9]{4,}$" },
          "page_url": { "type": "string", "pattern": "^/[^?#]*$" },
          "claim_type": { "type": "string", "minLength": 2 },
          "risk_level": { "enum": ["low", "medium", "high", "critical"] },
          "claim_text": { "type": "string", "minLength": 5 },
          "status": { "enum": ["needs_source_review", "source_found", "owner_confirmation", "qualified", "replaced", "verified", "rejected"] },
          "source_url": { "type": ["string", "null"], "pattern": "^https://" },
          "source_type": { "enum": ["none", "government", "regulator", "statute", "court", "official_disclosure", "public_pricing", "academic", "institutional", "secondary", "owner_confirmation"] },
          "source_title": { "type": ["string", "null"] },
          "evidence_reference": { "type": ["string", "null"] },
          "reviewed_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "reviewer": { "type": ["string", "null"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
